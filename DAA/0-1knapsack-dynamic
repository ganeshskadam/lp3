weight.append(...)	Stores each item's weight.
profit.append(...)	Stores each item's profit.
W = int(input(...))	Accepts the knapsack capacity.
dp = [0] * (W + 1)	Creates a DP array filled with zeros.
for i in range(n):	Processes each item.
for w in range(W, weight[i]-1, -1):	Checks capacities from largest to smallest.
profit[i] + dp[w-weight[i]]	Calculates profit if the item is selected.
max(dp[w], ...)	Chooses between selecting and skipping the item.
print("Maximum Profit =", dp[W])	Displays the maximum profit for capacity W.

