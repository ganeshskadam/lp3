Practical 5: N-Queens using Backtracking



def safe(b, r, c, n):
    for i in range(r):
        for j in range(n):
            if b[i][j] and (j == c or abs(i-r) == abs(j-c)):
                return False
    return True

def solve(b, r, n):
    if r == n:
        return True
    if any(b[r]):
        return solve(b, r+1, n)

    for c in range(n):
        if safe(b, r, c, n):
            b[r][c] = 1
            if solve(b, r+1, n):
                return True
            b[r][c] = 0
    return False

n = int(input("Enter value of N: "))
r = int(input("Enter first Queen row (1 to N): ")) - 1
c = int(input("Enter first Queen column (1 to N): ")) - 1

if n <= 0 or not (0 <= r < n and 0 <= c < n):
